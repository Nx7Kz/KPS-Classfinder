# คัดลอกเป็นไฟล์ .env บน VPS แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
# สุ่มรหัสได้ด้วย:  openssl rand -hex 24

DOMAIN=kps-classfinder.tech

# รหัส root ของ MySQL (ตั้งก่อนรันครั้งแรก — เปลี่ยนภายหลังต้องแก้ในฐานข้อมูลด้วย)
MYSQL_ROOT_PASSWORD=

# ใช้เซ็นคุกกี้ session  ยาวและสุ่ม
SESSION_SECRET=

# บัญชี Super Admin ตั้งต้น ใช้ครั้งแรกที่ตารางผู้ดูแลยังว่างเท่านั้น (ถ้าย้ายข้อมูลด้วยไฟล์สำรอง บัญชีจะมาจากไฟล์สำรอง)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
